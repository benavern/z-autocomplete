{
    "name": "@benavern/z-autocomplete",
    "version": "0.1.0",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/z-autocomplete.js",
    "module": "dist/z-autocomplete.js",
    "types": "dist/z-autocomplete.d.ts",
    "exports": {
        ".": {
            "types": "./dist/z-autocomplete.d.ts",
            "import": "./dist/z-autocomplete.js"
        }
    },
    "sideEffects": true,
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build:docs": "tsc && vite build --config vite.config.docs.js",
        "build:lib": "tsc && vite build --config vite.config.lib.js",
        "preview": "vite preview --config vite.config.docs.js",
        "prepublishOnly": "npm run build:lib",
        "lint:ts": "tsc --noEmit"
    },
    "peerDependencies": {
        "lit": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "lit": {
            "optional": true
        }
    },
    "devDependencies": {
        "lit": "^3.3.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4"
    }
}
